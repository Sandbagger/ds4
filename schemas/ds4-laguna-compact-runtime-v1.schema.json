        "status": { "$ref": "#/$defs/status" },
        "gates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gate" } },
        "results": { "$ref": "#/$defs/results" },
        "failure": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/failure" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "passed" } } },
          "then": { "properties": { "failure": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["failed", "invalid"] } } },
          "then": { "properties": { "failure": { "$ref": "#/$defs/failure" } } }
        }
      ]
    },
