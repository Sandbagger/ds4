{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ds4.eval.case/v1",
  "title": "DS4 stable case evaluation record",
  "$comment": "evidence_sha256 is SHA-256 of the exact UTF-8 byte stream beginning with the ASCII prefix ds4.eval.case.evidence/v1\n and followed for each of the preceding eight fields in required order by FIELD_NAME=DECIMAL_UTF8_BYTE_LENGTH:EXACT_UTF8_VALUE\n. Field names and length digits are ASCII; lengths count UTF-8 bytes; the final LF is included; evidence_sha256 and unrecorded model output are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "answer",
    "grade",
    "terminal_status",
    "request_id",
    "instance_id",
    "snapshot_seq",
    "evidence_sha256"
  ],
  "properties": {
    "schema": {
      "const": "ds4.eval.case/v1"
    },
    "case_id": {
      "type": "string",
      "enum": [
        "recNu3MXkvWUzHZr9",
        "001b51d76b4d422988f2c11f104a2c6c",
        "aime2025-01",
        "compsec-076"
      ]
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "grade": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not_graded"
      ]
    },
    "terminal_status": {
      "type": "string",
      "enum": [
        "completed",
        "cancelled",
        "rejected",
        "recoverable_error",
        "unsafe_error"
      ]
    },
    "request_id": {
      "$ref": "#/$defs/uuid"
    },
    "instance_id": {
      "$ref": "#/$defs/uuid"
    },
    "snapshot_seq": {
      "$ref": "#/$defs/nonzero_decimal"
    },
    "evidence_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000(?![\\s\\S]))[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "nonzero_decimal": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}
