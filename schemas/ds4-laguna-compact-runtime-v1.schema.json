    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "evidence"],
      "properties": {
        "code": { "enum": ["gate_failed", "infrastructure_invalid", "identity_mismatch", "evidence_invalid", "timeout", "process_failed"] },
