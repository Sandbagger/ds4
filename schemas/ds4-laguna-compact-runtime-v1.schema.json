      "type": "object",
      "additionalProperties": false,
      "required": ["resident_peak_bytes", "streamed_peak_bytes", "reduction_bytes", "reduction_ratio", "benchmark_samples", "model_inode_resident_bytes"],
      "properties": {
        "resident_peak_bytes": { "$ref": "#/$defs/uint64" },
        "streamed_peak_bytes": { "$ref": "#/$defs/uint64" },
        "reduction_bytes": { "$ref": "#/$defs/uint64" },
        "reduction_ratio": { "$ref": "#/$defs/finite_nonnegative_number" },
        "benchmark_samples": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "$ref": "#/$defs/benchmark_sample" } },
        "model_inode_resident_bytes": { "$ref": "#/$defs/uint64" }
      }
    },
