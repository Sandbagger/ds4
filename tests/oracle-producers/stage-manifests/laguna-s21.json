{
  "schema": "ds4-portcheck-stage-manifest/v1",
  "model": "laguna-s-2.1",
  "description": "Staged activation-capture vocabulary for Laguna S 2.1. Widths are expressions over shape params; heads resolves per layer via layer_class_rule (il%4==0 -> swa/48-head, else dense/72-head). Files are little-endian, token-major [rows x width].",
  "shape": {
    "n_layer": 48,
    "n_embd": 3072,
    "n_vocab": 100352,
    "head_dim": 128,
    "n_head_kv": 8,
    "n_head_dense": 72,
    "n_head_swa": 48,
    "n_expert": 256,
    "n_expert_used": 10,
    "n_ff_exp": 1024,
    "leading_dense": 1
  },
  "layer_class_rule": {"every": 4, "is": "swa", "else": "dense"},
  "stages": [
    {"stage": "embd",       "file": "embd.f32",   "dtype": "f32", "width": "n_embd",            "layers": "always"},
    {"stage": "attn-norm",  "dtype": "f32", "width": "n_embd",             "layers": "detail"},
    {"stage": "q-proj",     "dtype": "f32", "width": "heads*head_dim",     "layers": "detail"},
    {"stage": "k-proj",     "dtype": "f32", "width": "n_head_kv*head_dim", "layers": "detail"},
    {"stage": "v-proj",     "dtype": "f32", "width": "n_head_kv*head_dim", "layers": "detail"},
    {"stage": "gate-proj",  "dtype": "f32", "width": "heads",              "layers": "detail"},
    {"stage": "q-rope",     "dtype": "f32", "width": "heads*head_dim",     "layers": "detail"},
    {"stage": "k-rope",     "dtype": "f32", "width": "n_head_kv*head_dim", "layers": "detail"},
    {"stage": "attn-gated", "dtype": "f32", "width": "heads*head_dim",     "layers": "detail"},
    {"stage": "attn-o-proj","dtype": "f32", "width": "n_embd",             "layers": "detail", "optional": true},
    {"stage": "ffn-inp",    "dtype": "f32", "width": "n_embd",             "layers": "detail"},
    {"stage": "ffn-norm",   "dtype": "f32", "width": "n_embd",             "layers": "detail"},
    {"stage": "router-logits",   "dtype": "f32", "width": "n_expert",                 "layers": "routed"},
    {"stage": "router-selected", "dtype": "i32", "width": "n_expert_used",            "layers": "routed"},
    {"stage": "router-weights",  "dtype": "f32", "width": "n_expert_used",            "layers": "routed"},
    {"stage": "ffn-moe-input",     "dtype": "q8_1", "width": "n_embd",                     "layers": "routed", "optional": true},
    {"stage": "ffn-moe-gate",      "dtype": "f32",  "width": "n_expert_used*n_ff_exp",     "layers": "routed", "optional": true},
    {"stage": "ffn-moe-up",        "dtype": "f32",  "width": "n_expert_used*n_ff_exp",     "layers": "routed", "optional": true},
    {"stage": "ffn-moe-swiglu",    "dtype": "f32",  "width": "n_expert_used*n_ff_exp",     "layers": "routed", "optional": true},
    {"stage": "ffn-moe-col-l2",    "dtype": "f32",  "width": "n_expert_used",              "layers": "routed", "optional": true},
    {"stage": "ffn-moe-down-input","dtype": "f32",  "width": "n_expert_used*n_ff_exp",     "layers": "routed", "optional": true},
    {"stage": "ffn-moe-down-input-q81", "file": "layer-{ll}-ffn-moe-down-input.q8_1", "dtype": "q8_1", "width": "n_expert_used*n_ff_exp", "layers": "routed", "optional": true},
    {"stage": "ffn-moe-down",      "dtype": "f32",  "width": "n_expert_used*n_embd",       "layers": "routed", "optional": true},
    {"stage": "ffn-moe-weighted",  "dtype": "f32",  "width": "n_expert_used*n_embd",       "layers": "routed", "optional": true},
    {"stage": "ffn-moe-out",       "dtype": "f32",  "width": "n_embd",                     "layers": "routed", "optional": true},
    {"stage": "ffn-shared-out",    "dtype": "f32",  "width": "n_embd",                     "layers": "routed", "optional": true},
    {"stage": "ffn-out",    "dtype": "f32", "width": "n_embd",             "layers": "dense"},
    {"stage": "residual",   "file": "layer-{ll}.f32", "dtype": "f32", "width": "n_embd", "layers": "all"},
    {"stage": "logits",     "file": "logits.f32", "dtype": "f32", "width": "n_vocab", "layers": "always"}
  ]
}
