# Laguna S 2.1 model descriptor.
#
# Declares what the ds4 engine expects for arch "laguna" (variant S 2.1):
# shape scalars use the exact ds4.c DS4_SHAPE_LAGUNA_S21 field names so
# tests/test_model_check.py can pin this file to the C profile. Checking a
# GGUF against this file is an offline pre-flight; the engine remains the
# final authority at load time.

schema=ds4-model-descriptor/v1
arch=laguna
model=laguna-s-2.1

[layer_rule]
every=4
swa_heads=48
dense_heads=72
head_count_array=laguna.attention.head_count

[shape]
n_layer=48
n_embd=3072
n_vocab=100352
n_head=72
n_head_kv=8
n_head_dim=128
n_value_dim=128
n_rot=64
n_expert=256
n_expert_used=10
n_expert_shared=1
n_ff_exp=1024
n_ff_shared=1024
n_ff_dense=12288
n_swa=512
n_leading_dense=1
n_rot_swa=128
rms_eps=1.0e-6
expert_weight_scale=2.5
rope_freq_base=500000.0
rope_scale_factor=32.0
rope_yarn_beta_fast=32.0
rope_yarn_beta_slow=1.0
rope_yarn_attn_factor=1.0
rope_freq_base_swa=10000.0
context_length=262144
rope_orig_ctx=8192

[metadata]
general.architecture=="laguna"
laguna.block_count==48
laguna.context_length==262144
laguna.embedding_length==3072
laguna.vocab_size==100352
laguna.feed_forward_length==12288
laguna.attention.head_count_kv==8
laguna.attention.key_length==128
laguna.attention.value_length==128
laguna.rope.dimension_count==64
laguna.rope.dimension_count_swa==128
laguna.attention.sliding_window==512
laguna.expert_count==256
laguna.expert_used_count==10
laguna.expert_feed_forward_length==1024
laguna.expert_shared_feed_forward_length==1024
laguna.expert_gating_func==2
laguna.leading_dense_block_count==1
laguna.rope.scaling.type=="yarn"
laguna.rope.scaling.original_context_length==8192
laguna.rope.freq_base==500000.0
laguna.rope.freq_base_swa==10000.0
laguna.rope.scaling.factor==32.0
laguna.rope.scaling.yarn_attn_factor==1.0
laguna.rope.scaling.yarn_beta_fast==32.0
laguna.rope.scaling.yarn_beta_slow==1.0
laguna.attention.layer_norm_rms_epsilon==1e-06
laguna.expert_weights_scale==2.5
laguna.expert_weights_norm==true

[tensors.top]
token_embd.weight
output_norm.weight
output.weight

[tensors.all]
blk.%u.attn_norm.weight
blk.%u.attn_q.weight
blk.%u.attn_k.weight
blk.%u.attn_v.weight
blk.%u.attn_gate.weight
blk.%u.attn_q_norm.weight
blk.%u.attn_k_norm.weight
blk.%u.attn_output.weight
blk.%u.ffn_norm.weight

[tensors.dense]
blk.%u.ffn_gate.weight
blk.%u.ffn_up.weight
blk.%u.ffn_down.weight

[tensors.routed]
blk.%u.ffn_gate_inp.weight
blk.%u.exp_probs_b.bias
blk.%u.ffn_gate_exps.weight
blk.%u.ffn_up_exps.weight
blk.%u.ffn_down_exps.weight
blk.%u.ffn_gate_shexp.weight
blk.%u.ffn_up_shexp.weight
blk.%u.ffn_down_shexp.weight

[dims.top]
token_embd.weight=n_embd,n_vocab
output_norm.weight=n_embd
output.weight=n_embd,n_vocab

[dims.all]
blk.%u.attn_norm.weight=n_embd
blk.%u.attn_q.weight=n_embd,heads*n_head_dim
blk.%u.attn_k.weight=n_embd,n_head_kv*n_head_dim
blk.%u.attn_v.weight=n_embd,n_head_kv*n_head_dim
blk.%u.attn_gate.weight=n_embd,heads
blk.%u.attn_q_norm.weight=n_head_dim
blk.%u.attn_k_norm.weight=n_head_dim
blk.%u.attn_output.weight=heads*n_head_dim,n_embd
blk.%u.ffn_norm.weight=n_embd

[dims.dense]
blk.%u.ffn_gate.weight=n_embd,n_ff_dense
blk.%u.ffn_up.weight=n_embd,n_ff_dense
blk.%u.ffn_down.weight=n_ff_dense,n_embd

[dims.routed]
blk.%u.ffn_gate_inp.weight=n_embd,n_expert
blk.%u.exp_probs_b.bias=n_expert
blk.%u.ffn_gate_exps.weight=n_embd,n_ff_exp,n_expert
blk.%u.ffn_up_exps.weight=n_embd,n_ff_exp,n_expert
blk.%u.ffn_down_exps.weight=n_ff_exp,n_embd,n_expert
blk.%u.ffn_gate_shexp.weight=n_embd,n_ff_shared
blk.%u.ffn_up_shexp.weight=n_embd,n_ff_shared
blk.%u.ffn_down_shexp.weight=n_ff_shared,n_embd

[recipes]
signal-q8=token_embd.weight.type==Q8_0
legacy=token_embd.weight.type==Q4_K

[types.signal-q8]
token_embd.weight=Q8_0
output_norm.weight=F32
output.weight=Q8_0
blk.%u.attn_norm.weight=F32
blk.%u.attn_q.weight=Q8_0
blk.%u.attn_k.weight=Q8_0
blk.%u.attn_v.weight=Q8_0
blk.%u.attn_gate.weight=Q8_0
blk.%u.attn_q_norm.weight=F32
blk.%u.attn_k_norm.weight=F32
blk.%u.attn_output.weight=Q8_0
blk.%u.ffn_norm.weight=F32
blk.%u.ffn_gate.weight=Q8_0
blk.%u.ffn_up.weight=Q8_0
blk.%u.ffn_down.weight=Q8_0
blk.%u.ffn_gate_inp.weight=F32
blk.%u.exp_probs_b.bias=F32
blk.%u.ffn_gate_exps.weight=Q4_K
blk.%u.ffn_up_exps.weight=Q4_K
blk.%u.ffn_down_exps.weight=Q4_K
blk.%u.ffn_gate_shexp.weight=Q8_0
blk.%u.ffn_up_shexp.weight=Q8_0
blk.%u.ffn_down_shexp.weight=Q8_0

[types.legacy]
token_embd.weight=Q4_K
output_norm.weight=F32
output.weight=Q6_K
blk.%u.attn_norm.weight=F32
blk.%u.attn_q.weight=F16
blk.%u.attn_k.weight=F16
blk.%u.attn_v.weight=F16
blk.%u.attn_gate.weight=F16
blk.%u.attn_q_norm.weight=F32
blk.%u.attn_k_norm.weight=F32
blk.%u.attn_output.weight=F16
blk.%u.ffn_norm.weight=F32
blk.%u.ffn_gate.weight=Q4_K
blk.%u.ffn_up.weight=Q4_K
blk.%u.ffn_down.weight=Q6_K
blk.%u.ffn_gate_inp.weight=F32
blk.%u.exp_probs_b.bias=F32
blk.%u.ffn_gate_exps.weight=Q4_K
blk.%u.ffn_up_exps.weight=Q4_K
blk.%u.ffn_down_exps.weight=Q4_K|Q6_K
blk.%u.ffn_gate_shexp.weight=Q4_K
blk.%u.ffn_up_shexp.weight=Q4_K
blk.%u.ffn_down_shexp.weight=Q4_K|Q6_K

[names.hf]
# GGUF name = HF safetensors name, per the Poolside LagunaForCausalLM
# converter (poolside-llama.cpp conversion/laguna.py). Expert tensors are
# stacked per-layer from experts.{x}.{part} into one 3D exps tensor before
# mapping; the merged form is what appears here.
token_embd.weight=model.embed_tokens.weight
output_norm.weight=model.norm.weight
output.weight=lm_head.weight
blk.%u.attn_norm.weight=model.layers.%u.input_layernorm.weight
blk.%u.attn_q.weight=model.layers.%u.self_attn.q_proj.weight
blk.%u.attn_k.weight=model.layers.%u.self_attn.k_proj.weight
blk.%u.attn_v.weight=model.layers.%u.self_attn.v_proj.weight
blk.%u.attn_gate.weight=model.layers.%u.self_attn.g_proj.weight
blk.%u.attn_q_norm.weight=model.layers.%u.self_attn.q_norm.weight
blk.%u.attn_k_norm.weight=model.layers.%u.self_attn.k_norm.weight
blk.%u.attn_output.weight=model.layers.%u.self_attn.o_proj.weight
blk.%u.ffn_norm.weight=model.layers.%u.post_attention_layernorm.weight
blk.%u.ffn_gate.weight=model.layers.%u.mlp.gate_proj.weight
blk.%u.ffn_up.weight=model.layers.%u.mlp.up_proj.weight
blk.%u.ffn_down.weight=model.layers.%u.mlp.down_proj.weight
blk.%u.ffn_gate_inp.weight=model.layers.%u.mlp.gate.weight
blk.%u.exp_probs_b.bias=model.layers.%u.mlp.experts.e_score_correction_bias
blk.%u.ffn_gate_exps.weight=model.layers.%u.mlp.experts.gate_proj.weight
blk.%u.ffn_up_exps.weight=model.layers.%u.mlp.experts.up_proj.weight
blk.%u.ffn_down_exps.weight=model.layers.%u.mlp.experts.down_proj.weight
blk.%u.ffn_gate_shexp.weight=model.layers.%u.mlp.shared_expert.gate_proj.weight
blk.%u.ffn_up_shexp.weight=model.layers.%u.mlp.shared_expert.up_proj.weight
blk.%u.ffn_down_shexp.weight=model.layers.%u.mlp.shared_expert.down_proj.weight
