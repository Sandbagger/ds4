{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ds4.bench.qualification/v1",
  "title": "DS4 streamed qualification benchmark lifecycle record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_sha256",
    "sequence_sha256",
    "profile_id",
    "prompt_order_index",
    "prompt_id",
    "input_sha256",
    "event",
    "request_id",
    "instance_id",
    "snapshot_seq",
    "repetition_index",
    "monotonic_ns",
    "mode",
    "session_payload_bytes",
    "kv_allocated_bytes",
    "configured_prefill_rows",
    "allocated_prefill_rows",
    "expert_cache_limit_bytes",
    "expert_cache_current_bytes",
    "expert_cache_peak_bytes",
    "qualification_total_current_bytes",
    "qualification_total_bound_bytes",
    "qualification_total_peak_bytes",
    "model_inode_resident_bytes",
    "external_attribution",
    "runtime"
  ],
  "properties": {
    "schema": {
      "const": "ds4.bench.qualification/v1"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sequence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "profile_id": {
      "enum": [
        "cache-8gib",
        "cache-12gib",
        "cache-16gib"
      ]
    },
    "prompt_order_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "x-ds4-number-kind": "integer"
    },
    "prompt_id": {
      "enum": [
        "native-512",
        "native-2048",
        "native-8192",
        "native-28672"
      ]
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "event": {
      "enum": [
        "request_accepted",
        "first_token",
        "request_complete"
      ]
    },
    "request_id": {
      "$ref": "#/$defs/uuid"
    },
    "instance_id": {
      "$ref": "#/$defs/uuid"
    },
    "snapshot_seq": {
      "$ref": "#/$defs/uint64"
    },
    "repetition_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "x-ds4-number-kind": "integer"
    },
    "monotonic_ns": {
      "$ref": "#/$defs/positive_uint64"
    },
    "mode": {
      "const": "streamed"
    },
    "session_payload_bytes": {
      "$ref": "#/$defs/uint64"
    },
    "kv_allocated_bytes": {
      "$ref": "#/$defs/uint64"
    },
    "configured_prefill_rows": {
      "$ref": "#/$defs/positive_integer"
    },
    "allocated_prefill_rows": {
      "$ref": "#/$defs/positive_integer"
    },
    "expert_cache_limit_bytes": {
      "$ref": "#/$defs/uint64"
    },
    "expert_cache_current_bytes": {
      "$ref": "#/$defs/uint64"
    },
    "expert_cache_peak_bytes": {
      "$ref": "#/$defs/uint64"
    },
    "qualification_total_current_bytes": {
      "$ref": "#/$defs/uint64"
    },
    "qualification_total_bound_bytes": {
      "$ref": "#/$defs/uint64"
    },
    "qualification_total_peak_bytes": {
      "$ref": "#/$defs/uint64"
    },
    "model_inode_resident_bytes": {
      "$ref": "#/$defs/uint64"
    },
    "external_attribution": {
      "$ref": "#/$defs/external_attribution"
    },
    "runtime": {
      "$ref": "ds4-runtime-v1.schema.json",
      "x-ds4-canonical-json": true
    },
    "request_metrics": {
      "$ref": "ds4-runtime-request-v1.schema.json",
      "x-ds4-canonical-json": true
    },
    "terminal_status": {
      "enum": [
        "completed",
        "cancelled",
        "rejected",
        "recoverable_error",
        "unsafe_error"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "request_complete"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "request_metrics",
          "terminal_status"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "request_metrics"
              ]
            },
            {
              "required": [
                "terminal_status"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "uint64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])"
    },
    "positive_uint64": {
      "allOf": [
        {
          "$ref": "#/$defs/uint64"
        },
        {
          "not": {
            "const": "0"
          }
        }
      ]
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-ds4-number-kind": "integer"
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "external_attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_source_resident",
        "host_library_unattributed",
        "cuda_library_unattributed",
        "unrelated_process_inventory_stable"
      ],
      "properties": {
        "model_source_resident": {
          "$ref": "#/$defs/uint64"
        },
        "host_library_unattributed": {
          "$ref": "#/$defs/uint64"
        },
        "cuda_library_unattributed": {
          "$ref": "#/$defs/uint64"
        },
        "unrelated_process_inventory_stable": {
          "type": "boolean"
        }
      }
    }
  }
}
